# Tap Caps Lock for Escape; hold it for the Karabiner-style shortcuts.
# ponytail: named layer, not four modifiers; add real Hyper only if apps need it.
[main]
capslock = overload(hyper, esc)

[hyper]
a = home
d = end
w = pageup
s = pagedown
space = playpause
up = volumeup
down = volumedown
left = previoussong
right = nextsong
