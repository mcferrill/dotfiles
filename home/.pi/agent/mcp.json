{
  "$schema": "https://modelcontextprotocol.io/schema/config.json",
  "mcpServers": {
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--no-performance-crux",
        "--no-usage-statistics"
      ]
    },
    "agent-device": {
      "command": "npx",
      "args": [
        "-y",
        "agent-device@0.20.0",
        "mcp"
      ]
    },
    "ga4": {
      "url": "https://ga4-gtm-mcp-server.1-five-q-innovations.workers.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${GA4_MCP_TOKEN}"
      }
    },
    "agent-gateway": {
      "url": "https://agent-gateway.fiveq.dev/mcp"
    },
    "agent-gateway-dev": {
      "url": "http://localhost:8787/mcp",
      "oauth": {
        "scope": "mcp:read"
      },
      "description": "Local development Agent Gateway with authenticated read-only access",
      "exposure": "deferred"
    },
    "open-computer-use": {
      "enabled": false,
      "command": "npx",
      "args": [
        "mcp",
        "open-computer-use"
      ]
    }
  }
}
