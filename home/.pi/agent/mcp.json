{
  "$schema": "https://modelcontextprotocol.io/schema/config.json",
  "mcpServers": {
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--no-performance-crux",
        "--no-usage-statistics"
      ]
    },
    "agent-device": {
      "command": "npx",
      "args": [
        "-y",
        "agent-device@0.20.0",
        "mcp"
      ]
    },
    "ga4": {
      "url": "https://ga4-gtm-mcp-server.1-five-q-innovations.workers.dev/mcp",
      "headers": {
        "Authorization": "!token=\"$GA4_MCP_TOKEN\"; if [ -z \"$token\" ] && command -v security >/dev/null 2>&1; then token=$(security find-generic-password -s ga4-mcp-token -w); fi; if [ -z \"$token\" ]; then printf '%s\\n' 'GA4 token missing: export GA4_TOKEN or configure macOS Keychain' >&2; exit 1; fi; printf 'Bearer %s' \"$token\""
      }
    },
    "agent-gateway": {
      "url": "https://agent-gateway.fiveq.dev/mcp",
      "oauth": {
        "scope": "mcp:read mcp:write offline_access"
      }
    },
    "agent-gateway-dev": {
      "enabled": false,
      "url": "http://localhost:8787/mcp",
      "oauth": {
        "scope": "mcp:read"
      },
      "description": "Local development Agent Gateway with authenticated read-only access. Use only when explicitly requested.",
      "exposure": "deferred"
    },
    "hypruse": {
      "command": "uvx",
      "args": [
        "hypruse"
      ],
      "env": {
        "HYPRUSE_READONLY": "1"
      },
      "description": "Read-only Hyprland desktop discovery, screenshots, and accessibility inspection. No input or app launching.",
      "enabled": false
    },
    "open-computer-use": {
      "command": "npx",
      "args": [
        "-y",
        "open-computer-use@latest",
        "mcp"
      ],
      "env": {
        "PATH": "/usr/bin:${PATH}"
      },
      "enabled": false
    },
    "fiveq-compass": {
      "url": "https://fiveq-compass-mcp.fiveq.com/mcp"
    }
  }
}
