#!/usr/bin/env node
import { copyFileSync, existsSync, mkdirSync, readFileSync, renameSync, unlinkSync, writeFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { resolve } from "node:path";

const directory = resolve(process.argv[2]);
const layout = "main-smart-nav-insights";
function saveJson(path, value) {
  const content = `${JSON.stringify(value, null, 2)}\n`;
  if (existsSync(path) && readFileSync(path, "utf8") === content) return;
  const temporary = `${path}.tmp-${process.pid}`;
  if (existsSync(path)) copyFileSync(path, `${path}.backup.${Date.now()}-${process.pid}`);
  try {
    writeFileSync(temporary, content, { flag: "wx", mode: 0o600 });
    renameSync(temporary, path);
  } finally {
    if (existsSync(temporary)) unlinkSync(temporary);
  }
}
// The desktop may not inherit mise's PATH. Resolve Node on each machine, not in Git.
mkdirSync(`${directory}/mods/insights`, { recursive: true });
saveJson(`${directory}/mods/insights/runtime.json`, { node: process.execPath });
const env = { ...process.env, HERDR_APP_HOME: directory };
const status = spawnSync("herdr-app", ["status"], { env, encoding: "utf8" });
if (status.status === 0) {
  // Let the running app persist its own state; never race its shared.json writer.
  const result = spawnSync("herdr-app", ["do", "layout.switch", "--name", layout], { env, encoding: "utf8" });
  if (result.status !== 0) throw new Error(result.stderr || result.error?.message || "Herdr layout activation failed");
} else {
  const path = `${directory}/shared.json`;
  const exists = existsSync(path);
  const state = exists ? JSON.parse(readFileSync(path, "utf8")) : {};
  if (!state || typeof state !== "object" || Array.isArray(state)) throw new Error(`${path}: expected a JSON object`);
  if (state.layout !== layout || state["frame.welcomed"] !== "finished") {
    state.layout = layout;
    state["frame.welcomed"] = "finished";
    saveJson(path, state);
  }
}
